{
  "permissions": {
    "allow": [
      "Read(./.env.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ],
    "ask": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run .claude/hooks/user-prompt-submit/timezone-context.ts"
          },
          {
            "type": "command",
            "command": "bun run .claude/hooks/user-prompt-submit/library-detection.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun run .claude/hooks/post-tool-use/lint-check.ts"
          }
        ]
      }
    ]
  }
}